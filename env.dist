# HTTP listen address. Default: :8080.
HTTP_ADDR=:8080

# SQLite file path. Default: ./data/app.db. Do not use ?, # or % in the path.
# Pending migrations always run at startup, before optional seeds and HTTP serving.
DATABASE_PATH=./data/app.db

# Minimum level for both zerolog and slog. Default: info.
# Supported levels: trace, debug, info, warn, error, fatal, panic, disabled.
LOG_LEVEL=info

# true: readable terminal logs; false: JSON for cloud/structured log collection.
# Application default: false. This local-development template opts into true.
LOG_PRETTY=true

# Opt-in demo users (Ada Lovelace and Grace Hopper). Default: false.
# Embedded SQL seeds run in filename order, in one transaction after migrations.
# Repeated runs preserve existing users; deleted demo users return while enabled.
DB_SEED_ENABLED=false
